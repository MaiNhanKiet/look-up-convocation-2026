# Public site URL used for Open Graph. Example: https://convocation.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hero arrow and motto replay interval in milliseconds. Minimum: 3500.
NEXT_PUBLIC_HERO_ANIMATION_INTERVAL_MS=5000

# Self-hosted PostgreSQL. Server only. Example:
# postgresql://postgres:password@localhost:5432/convocation
DATABASE_URL=postgresql://postgres:password@localhost:5432/convocation

# MinIO. Server only. The browser receives a short-lived URL for each LED image.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=led-images
# Public HTTPS origin used to sign browser URLs. Leave empty to proxy images through Next.js.
# On the host, MINIO_ENDPOINT stays 127.0.0.1. Inside Docker a loopback value is read as the service name minio.
MINIO_PUBLIC_ENDPOINT=

# full enables the hidden-by-default email reveal control. masked disables revealing.
PUBLIC_EMAIL_MODE=full

# Required in production so rate-limit keys are not derived from a shared development salt.
RATE_LIMIT_SALT=replace-with-a-long-random-string
LOOKUP_RATE_LIMIT=8
LOOKUP_RATE_WINDOW_SECONDS=60

# Optional. Set both values to require Cloudflare Turnstile on lookup.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# true keeps the page and replaces the lookup card with the maintenance message.
MAINTENANCE_MODE=false

# Reopen time in Asia/Ho_Chi_Minh, HH-DD-MM-YYYY.
# 13-25-10-2026 means 13:00 on 25/10/2026. After that moment the clock stays at 00.
MAINTENANCE_REOPEN_AT=

# Opened in a new tab by "Gửi yêu cầu chỉnh sửa". Leave empty to hide the button.
CORRECTION_FORM_URL=
